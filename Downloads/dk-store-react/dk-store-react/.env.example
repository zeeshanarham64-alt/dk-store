PORT=3000
# Admin account, created on first start. If left empty a random password is printed in the console once.
ADMIN_EMAIL=admin@dkstore.local
ADMIN_PASSWORD=
# Vercel + Supabase: set SUPABASE_DB_URL to the project's transaction pooler connection string.
SUPABASE_DB_URL=
SESSION_SECRET=
# (at least 10 characters with letters and numbers, the server refuses weaker ones)
# WhatsApp number, country code first, no + or spaces
WHATSAPP=923141993887
# Email every new order to the shop (Gmail). Needs 2-Step Verification on the Gmail account,
# then create an App Password: Google Account > Security > App passwords. Paste the 16 letters here.
SMTP_USER=dkstore125@gmail.com
SMTP_PASS=
# Where order emails go (defaults to SMTP_USER)
SHOP_EMAIL=dkstore125@gmail.com
# Your website address, so the email can link to the admin page (optional)
SITE_URL=
# Set to 1 when the site runs on https (always do this on a real website)
COOKIE_SECURE=0
# Set to 1 when the site is behind your host's proxy (Render, Railway, nginx, Caddy)
TRUST_PROXY=0
# Optional lock: admin login and admin pages only work from these addresses (comma separated)
ADMIN_IPS=
# Optional: where the database lives (default ./data)
# DATA_DIR=./data
